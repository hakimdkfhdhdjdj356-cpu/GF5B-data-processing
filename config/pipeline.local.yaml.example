# 本机配置示例。复制为 config/pipeline.local.yaml 后按需修改。
# 该文件已被 .gitignore 排除（config/*local*），不会进入版本库。
#
# 用法：
#   python scripts/run_ahsi.py --config config/pipeline.local.yaml plan
#
# 路径可以用 ${ENV:变量名} 引用环境变量；load_config 遇到未设置的环境变量会直接报错，
# 不会静默回退到错误目录。若不想用环境变量，直接写相对或绝对路径也可以。
version: 1

project_root: "${ENV:AHSI_PROJECT_ROOT}"
input_root: "${ENV:AHSI_INPUT_ROOT}"
output_root: "${ENV:AHSI_OUTPUT_ROOT}"
auxiliary_root: "${ENV:AHSI_AUX_ROOT}"
golden_root: "${ENV:AHSI_GOLDEN_ROOT}"

grid:
  crs: "EPSG:32648"
  resolution_m: 30
  nodata: -9999.0
  resampling: bilinear
  rpc_dem: "rpc_dem_ellipsoid.tif"
  geoid_grid: "egm08_25.tif"
  apply_vdatum_shift: true
  auto_utm: true

bands:
  wavelength_min_nm: 420
  wavelength_max_nm: 2400
  water_absorption_nm:
    - [755, 775]
    - [930, 980]
    - [1350, 1460]
    - [1800, 1980]
  vnir_max_nm: 1000
  swir_min_nm: 1030
  keep_all_bands_in_radiance: true

atmospheric:
  enabled: true
  method: iarr
  on_unavailable: "stop_at_radiance"
  iarr:
    normalization: scene_mean
    robust_pct: [2, 98]
    min_valid_pixels: 1000
    require_positive_radiance: true
  envi_taskengine: ""
  sensor: "Generic / Unknown Sensor"
  license_timeout_s: 20
  timeout_s: 900
  reflectance_scale: 10000
  accept_nonzero_exit_with_valid_output: true

  # 若改用 sixs_lut 后端，取消下面注释并填写本机 6S 可执行文件路径与大气情景。
  # 情景必须恰有一个 nominal=true；AOT/水汽/臭氧为假设值，不是影像反演结果。
  # sixs:
  #   executable: "/path/to/6SV1.1/sixs.exe"
  #   scenarios:
  #     - {id: clear,   aot550: 0.10, water_g_cm2: 0.8, ozone_atm_cm: 0.30, nominal: true}
  #     - {id: hazy,    aot550: 0.35, water_g_cm2: 1.5, ozone_atm_cm: 0.30, nominal: false}
  #     - {id: humid,   aot550: 0.10, water_g_cm2: 2.5, ozone_atm_cm: 0.30, nominal: false}

scene_assets: {}

qc:
  min_joint_coverage_km2: 100
  max_rpc_roundtrip_pixels: 1.0
  max_ogp_solar_zenith_diff_deg: 0.5
  require_wavelength_monotonic: true
  require_complete_readback: true
  max_fraction_above_1: 0.10
  max_fraction_above_2: 0.02
  fail_on: []

runtime:
  band_chunk: 8
  compression: deflate
  compress_level: 4
  tiled: true
  block_size: 256
  min_free_gb: 40
  hash_inputs: false
  keep_intermediates: true
  log_level: INFO
